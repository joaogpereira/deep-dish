# Build do app Android (npm run build:mobile). Copie para .env.mobile.local.
# Só sobrescreve o que muda no celular; o resto (ex.: VITE_REVERB_APP_KEY) vem do .env.
#
# No celular, "localhost" é o próprio celular: use o IP da máquina que roda o backend
# na rede Wi-Fi (Windows: ipconfig -> "Endereço IPv4"). Celular e PC na mesma rede.
VITE_API_URL=http://192.168.0.10:8000/api
VITE_REVERB_HOST=192.168.0.10
