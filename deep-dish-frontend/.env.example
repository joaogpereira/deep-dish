# Copie para .env e preencha com os valores corretos
VITE_API_URL=http://localhost:8000/api

# Reverb (tempo real). A key deve bater com REVERB_APP_KEY do backend.
# O host aqui e visto do navegador, entao e localhost, nao o nome do servico Docker.
VITE_REVERB_APP_KEY=localkey
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http
