APP_NAME="Deep Dish"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Com a porta: e a base da URL das imagens no disco 'public' (APP_URL/storage/...).
APP_URL=http://localhost:8000

# Gere com: php artisan jwt:secret
# Sem esta chave o tymon/jwt-auth derruba o boot da aplicacao.
JWT_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# BANCO — deixe UM bloco ativo e o outro comentado. Depois de trocar:
# 'docker compose up -d' (NAO 'restart': ele nao rele este arquivo).
# Os enderecos sao os de DENTRO da rede do Docker. Os testes nao leem daqui:
# o phpunit.xml aponta sempre para 127.0.0.1:5433/deepdish_test, a partir do host.
DB_CONNECTION=pgsql

# --- Local: container 'postgres_test', banco 'deepdish_dev' (padrao) ---
# O banco e criado sozinho na primeira subida. As tabelas nao:
#   docker compose exec backend php artisan migrate --seed
DB_HOST=postgres_test
DB_PORT=5432
DB_DATABASE=deepdish_dev
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_SSLMODE=disable

# --- Supabase via pooler (Supavisor). Dashboard → Database → Connection pooling ---
# Use o pooler, nao o host direto 'db.<ref>.supabase.co': o direto so resolve para IPv6,
# e containers Docker nao tem IPv6 — dentro do Compose a conexao falha com
# "Network is unreachable". Note que o usuario inclui o project ref.
# DB_HOST=aws-1-YOUR_REGION.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.YOUR_PROJECT_REF
# DB_PASSWORD=
# DB_SSLMODE=require

# SQLite (alternativa local)
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# BROADCAST_CONNECTION fica definido na secao de Reverb, no fim do arquivo.
# FILESYSTEM_DISK fica definido na secao de Imagens, logo abaixo do AWS.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Padrão local: escreve o e-mail no log em vez de enviar (storage/logs/laravel.log).
# Para disparo real via Gmail SMTP: MAIL_MAILER=smtp, MAIL_SCHEME=smtp,
# MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME/MAIL_FROM_ADDRESS = seu
# e-mail Gmail, MAIL_PASSWORD = senha de app (sem espaços) gerada em
# https://myaccount.google.com/apppasswords (exige verificação em 2 etapas ativada).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================================================
# IMAGENS (fotos dos restaurantes) — deixe UM valor de FILESYSTEM_DISK ativo.
# O banco guarda so o caminho ("restaurantes/x.jpg"); a URL e montada pelo disco
# escolhido aqui. Trocar de disco nao exige migrar dados nem mexer no frontend.
# Depois de trocar: docker compose up -d (NAO 'restart').
# ============================================================================

# --- Local: pasta storage/app/public, servida pelo backend em APP_URL/storage ---
FILESYSTEM_DISK=public

# --- Supabase Storage (homologacao/producao), pela API compativel com S3 ---
# Painel: Storage > Settings > S3 Connection. O bucket precisa ser PUBLICO.
# As chaves S3 dao escrita no bucket: nunca no frontend, nunca no git.
# FILESYSTEM_DISK=supabase
# SUPABASE_STORAGE_KEY=
# SUPABASE_STORAGE_SECRET=
# SUPABASE_STORAGE_REGION=sa-east-1
# SUPABASE_STORAGE_BUCKET=imagens
# SUPABASE_STORAGE_ENDPOINT=https://SEU_PROJECT_REF.storage.supabase.co/storage/v1/s3
# SUPABASE_STORAGE_URL=https://SEU_PROJECT_REF.supabase.co/storage/v1/object/public/imagens

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:8080

# Broadcasting em tempo real (Laravel Reverb).
# As credenciais abaixo sao so para dev local. Nao deixe vazias: sem elas o
# 'reverb:start' sobe e morre em ~60s sem logar erro, e o Compose fica
# reiniciando o servico em loop. Em producao, gere outras com: php artisan reverb:install
#
# Esta e a UNICA definicao de BROADCAST_CONNECTION no arquivo. Valores possiveis:
#   reverb -> tempo real de verdade; exige o servico 'reverb' rodando
#   log    -> escreve o evento no log em vez de transmitir (util sem o servico)
#   null   -> descarta os eventos (usado pelos testes, via phpunit.xml)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=deepdish-local
REVERB_APP_KEY=localkey
REVERB_APP_SECRET=localsecret

# Como o backend alcanca o servidor Reverb. Dentro do Compose e o nome do
# servico ('reverb'); fora do Docker, use 127.0.0.1.
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=http

# Onde o processo 'reverb:start' escuta. A porta 8080 ja e do frontend.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081

# Fila: minutos entre a chamada para a mesa e o check-in antes de o cliente
# virar no-show ('expirado'). Lido pelo 'fila:expirar-chamados'. Padrao: 15.
FILA_TOLERANCIA_CHAMADA_MINUTOS=15
